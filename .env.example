# Website login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password
# Optional extra admins, each with their own separate list of accounts
ADMINS=priya:another-strong-password,amit:yet-another-password
# Long random string. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Don't change it after saving accounts - saved app passwords are encrypted with it.
SECRET_KEY=

# Postgres connection string from neon.tech. Leave unset locally to use accounts.db.
DATABASE_URL=

# Telegram bot (optional - the website works without it)
TELEGRAM_BOT_TOKEN=123456:your-bot-token-from-botfather
ALLOWED_TELEGRAM_IDS=your-telegram-user-id

# Only needed for local use of otp_fetch.py (the CLI script, not the bot)
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=yourapppassword16
